# ─── Docker Compose environment template ─────────────────────────────────────
# Copy this file to .env in the project root, fill in the values, then run:
#   docker compose up -d --build
# The compose file refuses to start if any *_PASSWORD or ENCRYPTION_KEY value
# is left empty — that is intentional.

# ─── Networking ──────────────────────────────────────────────────────────────
# Host port to publish the app on. The container always listens on 8080
# internally; this only controls what your host exposes.
APP_PORT=8085

# CORS / cookie origin — must match the URL users type in their browser.
# Examples:  http://localhost:8085  •  https://swift.example.com
ALLOWED_ORIGIN=http://localhost:8085

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# These are read by both the db service and the app. Use a strong random
# password (e.g. `openssl rand -base64 32`).
POSTGRES_DB=footprint
POSTGRES_USER=footprint
POSTGRES_PASSWORD=replace-me-with-a-strong-random-password

# ─── First-boot admin account ────────────────────────────────────────────────
# Created automatically if no users exist yet. Change the password before any
# untrusted user has network access to the app.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=replace-me-with-a-strong-password

# ─── Token encryption ────────────────────────────────────────────────────────
# Used to encrypt stored API keys + integration secrets at rest. 64 hex chars.
# Generate with:   openssl rand -hex 32
ENCRYPTION_KEY=replace-me-with-64-hex-characters

# ─── Observability (optional) ────────────────────────────────────────────────
# Bearer token required to scrape /metrics. Leave unset to keep the endpoint
# admin-session-gated. Generate with:  openssl rand -hex 24
# METRICS_TOKEN=

# ─── Optional plugin API keys ────────────────────────────────────────────────
# Uncomment the ones you have. Plugins without a key skip silently.
# HIBP_API_KEY=
# SHODAN_API_KEY=
# VIRUSTOTAL_API_KEY=
# ABUSEIPDB_API_KEY=
# ABSTRACT_PHONE_API_KEY=

# ─── Optional SMTP (password reset + scheduled-scan alerts) ──────────────────
# Leave blank to disable e-mail entirely.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
