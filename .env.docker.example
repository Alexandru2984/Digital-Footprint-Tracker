# ─── Docker Compose environment template ─────────────────────────────────────
# Copy this file to .env in the project root, fill in the values, then run:
#   docker compose up -d --build
# The compose file refuses to start if any required password, encryption key or
# audit secret is left empty — that is intentional.

# ─── Networking ──────────────────────────────────────────────────────────────
# Host port to publish the app on. The container always listens on 8080
# internally; this only controls what your host exposes.
APP_PORT=8085

# CORS / cookie origin — must match the URL users type in their browser.
# Examples:  http://localhost:8085  •  https://swift.example.com
ALLOWED_ORIGIN=http://localhost:8085

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# These are read by both the db service and the app. Use a strong random
# password (e.g. `openssl rand -base64 32`).
POSTGRES_DB=footprint
POSTGRES_USER=footprint
POSTGRES_PASSWORD=replace-me-with-a-strong-random-password

# ─── First-boot admin account ────────────────────────────────────────────────
# Created automatically if no users exist yet. Change the password before any
# untrusted user has network access to the app.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=replace-me-with-a-strong-password

# ─── Sensitive-field encryption ─────────────────────────────────────────────
# Required in production. Encrypts scan/result/board data, notification
# credentials, schedules, audit details, and cache payloads. 64 hex chars.
# Keep a separate protected backup: replacing or losing this key makes existing
# encrypted data unavailable and the persistent key check will stop startup.
# Generate with:   openssl rand -hex 32
ENCRYPTION_KEY=replace-me-with-64-hex-characters
# Stable, non-secret identifier embedded in v2 envelopes. Change it whenever
# ENCRYPTION_KEY changes; allowed characters: letters, digits, dot, dash, underscore.
ENCRYPTION_KEY_ID=primary
# Keep v1 writes during the reader-first deployment. Switch to 2 only after
# every running app/worker understands v2 and the rotation runbook is prepared.
ENCRYPTION_WRITE_VERSION=1
# During rotation, list at most four old keys as comma-separated id=64hex pairs.
# This value is secret and must never be committed or left behind after rewrap.
# ENCRYPTION_PREVIOUS_KEYS=2026-q2=replace-with-the-previous-64-hex-key

# ─── Tamper-evident audit signing ────────────────────────────────────────────
# Required in production and deliberately separate from ENCRYPTION_KEY.
# This is a raw 32-byte Ed25519 private seed encoded as 64 hex characters.
# Keep it in the same protected secret store as the encryption key.
# Generate with:   openssl rand -hex 32
AUDIT_SIGNING_KEY=
# Non-secret identifier. Change it whenever AUDIT_SIGNING_KEY changes; startup
# appends a signed key-transition checkpoint before serving requests.
AUDIT_SIGNING_KEY_ID=audit-primary
# Stable secret used only for HMAC commitments to low-entropy audit fields.
# Generate independently and preserve it across signing/encryption-key rotations.
AUDIT_COMMITMENT_KEY=

# ─── Scan workload bounds (optional) ────────────────────────────────────────
# A full scan fans out into many outbound requests. Keep these conservative on
# a shared VPS. Values are clamped by the application (1–16 / 0–256).
SCAN_MAX_CONCURRENT=3
SCAN_MAX_QUEUED=32

# ─── Durable notification delivery (optional) ───────────────────────────────
# Invalid present values fail boot. Automatic notifications are encrypted in
# PostgreSQL and delivered at least once; see docs/NOTIFICATION_DELIVERY.md.
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_POLL_SECONDS=2
NOTIFICATION_LEASE_SECONDS=60
NOTIFICATION_RETENTION_DAYS=30

# ─── Asynchronous exports (optional) ─────────────────────────────────────────
# Artifacts and completeness manifests are encrypted in PostgreSQL and expire.
# Invalid present values fail boot; see docs/ASYNC_EXPORTS.md.
EXPORT_WORKER_ENABLED=true
EXPORT_POLL_SECONDS=2
EXPORT_LEASE_SECONDS=120
EXPORT_RETENTION_HOURS=24
EXPORT_MAX_OUTSTANDING_PER_USER=3
EXPORT_MAX_JOBS_PER_USER_PER_DAY=20
EXPORT_MAX_RESULTS=10000
EXPORT_BATCH_SIZE=250
EXPORT_MAX_SOURCE_MIB=10
EXPORT_MAX_ARTIFACT_MIB=20
EXPORT_MAX_ATTEMPTS=2

# ─── Observability (optional) ────────────────────────────────────────────────
# Bearer token required to scrape /metrics. Leave unset to keep the endpoint
# admin-session-gated. Generate with:  openssl rand -hex 24
# METRICS_TOKEN=

# ─── Optional plugin API keys ────────────────────────────────────────────────
# Uncomment the ones you have. Plugins without a key skip silently.
# HIBP_API_KEY=
# SHODAN_API_KEY=
# VIRUSTOTAL_API_KEY=
# ABUSEIPDB_API_KEY=
# ABSTRACT_PHONE_API_KEY=

# ─── Optional SMTP (password reset + scheduled-scan alerts) ──────────────────
# Leave blank to disable e-mail entirely.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
