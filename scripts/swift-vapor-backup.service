[Unit]
Description=swift-vapor PostgreSQL daily backup
Documentation=https://github.com/Alexandru2984/Digital-Footprint-Tracker
After=postgresql.service network-online.target
Wants=postgresql.service

[Service]
Type=oneshot
User=micu
Group=micu
WorkingDirectory=/home/micu/swift+vapor
ExecStart=/home/micu/swift+vapor/scripts/backup.sh
LoadCredentialEncrypted=backup-passphrase:/etc/credstore.encrypted/swift-vapor-backup-passphrase
Environment=BACKUP_STATUS_FILE=/var/lib/swift-vapor-backup/last-success
StateDirectory=swift-vapor-backup
StateDirectoryMode=0755

# The job sees this repository read-only, localhost, its private credential, and
# the backup directory. It has no reason to inspect other homes or use internet.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/micu/swift+vapor
ReadWritePaths=/home/micu/swift-vapor-backups
PrivateTmp=true
PrivateDevices=true
ProtectHostname=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=localhost
IPAddressDeny=any
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
MemoryDenyWriteExecute=true
UMask=0077
KeyringMode=private
RemoveIPC=true

# Resource ceilings — pg_dump compressing a multi-GB database can spike.
# These match swift-vapor.service's posture: high enough to never abort a
# legitimate dump, low enough to flag runaway behaviour.
MemoryMax=512M
CPUQuota=200%

[Install]
WantedBy=multi-user.target
