[Unit]
Description=Run swift-vapor PostgreSQL backup daily
Documentation=https://github.com/Alexandru2984/Digital-Footprint-Tracker

[Timer]
# 02:00 UTC every day — quiet hours, minimal contention with normal scans.
OnCalendar=*-*-* 02:00:00 UTC

# Randomise within a 10-minute window so multiple hosts running this exact
# timer don't all dump at the same wall-clock second.
RandomizedDelaySec=600

# If the system was off at 02:00, run the missed job on next boot. Without
# this, downtime that spans the trigger silently skips that day's dump.
Persistent=true

Unit=swift-vapor-backup.service

[Install]
WantedBy=timers.target
