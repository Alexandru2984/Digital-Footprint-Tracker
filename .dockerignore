# VCS
.git/
.gitignore
.gitattributes

# Swift build artefacts — must be rebuilt inside the container
.build/
.swiftpm/
Packages/

# Local env / secrets — never bake these into an image
.env
.env.*
!.env.docker.example

# Local backups / archives
*.tar
*.tar.gz
*.tar.zst
*.bak
*.bak.*

# Logs
*.log

# Editor / OS junk
.DS_Store
.vscode/
.idea/
*.swp

# Docs are useful in the repo but not at runtime; excluding cuts build context.
docs/
CONTRIBUTING.md

# SwiftPM validates the declared test target while planning a product build, so
# Tests/ must remain in the builder context even though it is not in runtime.
