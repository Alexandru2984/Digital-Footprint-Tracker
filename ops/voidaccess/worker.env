# Non-secret runtime settings for swift-vapor-voidaccess.service.
# The HMAC secret is injected separately with a systemd encrypted credential.
VOIDACCESS_EXECUTABLE=/opt/voidaccess/current/venv/bin/voidaccess
VOIDACCESS_PYTHON=/opt/voidaccess/current/venv/bin/python
VOIDACCESS_LISTEN_HOST=127.0.0.1
VOIDACCESS_LISTEN_PORT=8766
VOIDACCESS_JOB_TIMEOUT_SECONDS=540
TOR_PROXY_HOST=127.0.0.1
TOR_PROXY_PORT=9050
