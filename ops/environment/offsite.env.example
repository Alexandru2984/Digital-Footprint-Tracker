# Non-secret routing for swift-vapor-offsite.service. Install as
# /etc/swift-vapor/offsite.env owned by root with mode 0644. The credential that
# can write to the destination is a separate encrypted systemd credential
# (swift-vapor-rclone-config); it does not belong here.
#
# The artifacts are already GPG-encrypted and verified by backup.sh, so the
# destination only ever holds ciphertext. Nothing is ever deleted there.

# An rclone remote and path. The remote must exist in the minimal config
# provisioned as the swift-vapor-rclone-config credential.
OFFSITE_REMOTE=gdrive:Backup_VPS/swift-vapor

# Parallel transfers. Two is plenty for a handful of small artifacts.
OFFSITE_TRANSFERS=2
