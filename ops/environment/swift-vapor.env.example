# Non-secret production settings. Install as /etc/swift-vapor/app.env owned by
# root with mode 0644. Passwords, tokens and private keys do not belong here.

DATABASE_HOST=127.0.0.1
DATABASE_USERNAME=footprint_user
DATABASE_NAME=footprint_db

ALLOWED_ORIGIN=https://swift.micutu.com
BASE_URL=https://swift.micutu.com
ENCRYPTION_KEY_ID=primary
ENCRYPTION_WRITE_VERSION=1
AUDIT_SIGNING_KEY_ID=audit-primary

# Existing deployments do not need an admin password at runtime. For an empty
# database, mount ADMIN_PASSWORD only on the migration unit using the reviewed
# bootstrap drop-in, then remove that credential immediately after seeding.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@localhost

SCAN_MAX_CONCURRENT=3
SCAN_MAX_QUEUED=32
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_POLL_SECONDS=2
NOTIFICATION_LEASE_SECONDS=60
NOTIFICATION_RETENTION_DAYS=30
EXPORT_WORKER_ENABLED=true
EXPORT_POLL_SECONDS=2
EXPORT_LEASE_SECONDS=120
EXPORT_RETENTION_HOURS=24
EXPORT_MAX_OUTSTANDING_PER_USER=3
EXPORT_MAX_JOBS_PER_USER_PER_DAY=20
EXPORT_MAX_RESULTS=10000
EXPORT_BATCH_SIZE=250
EXPORT_MAX_SOURCE_MIB=10
EXPORT_MAX_ARTIFACT_MIB=20
EXPORT_MAX_ATTEMPTS=2

DARK_WEB_ENABLED=false
DARK_WEB_WORKER_URL=http://127.0.0.1:8766
DARK_WEB_RETENTION_HOURS=72
DARK_WEB_MAX_OUTSTANDING=5
DARK_WEB_MAX_JOBS_PER_USER_DAY=3
DARK_WEB_JOB_TIMEOUT_SECONDS=600

BACKUP_STATUS_FILE=/var/lib/swift-vapor-backup/status/last-success
BACKUP_MAX_AGE_SECONDS=108000
BACKUP_RETENTION=7

# Non-secret SMTP routing may be added here. SMTP_PASS is always a credential.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=mailer@example.com
# SMTP_FROM=noreply@example.com
