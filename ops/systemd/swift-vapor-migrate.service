[Unit]
Description=Swift Vapor explicit database migration gate
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=swift-vapor
Group=swift-vapor
WorkingDirectory=/srv/swift-vapor/next
EnvironmentFile=/etc/swift-vapor/app.env
LoadCredentialEncrypted=database-password:/etc/credstore.encrypted/swift-vapor-database-password
LoadCredentialEncrypted=encryption-key:/etc/credstore.encrypted/swift-vapor-encryption-key
LoadCredentialEncrypted=audit-signing-key:/etc/credstore.encrypted/swift-vapor-audit-signing-key
LoadCredentialEncrypted=audit-commitment-key:/etc/credstore.encrypted/swift-vapor-audit-commitment-key
Environment=DATABASE_PASSWORD_FILE=%d/database-password
Environment=ENCRYPTION_KEY_FILE=%d/encryption-key
Environment=AUDIT_SIGNING_KEY_FILE=%d/audit-signing-key
Environment=AUDIT_COMMITMENT_KEY_FILE=%d/audit-commitment-key
# /usr/bin/env applies migration-only safety overrides; the web unit
# independently forces AUTO_MIGRATE=false.
ExecStart=/usr/bin/env AUTO_MIGRATE=true DARK_WEB_ENABLED=false NOTIFICATION_WORKER_ENABLED=false EXPORT_WORKER_ENABLED=false REPORT_SCRIPT_PATH=/srv/swift-vapor/next/scripts/generate_report.py /srv/swift-vapor/next/Run migrate --yes --env production

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
BindReadOnlyPaths=/srv/swift-vapor/next
PrivateTmp=true
PrivateDevices=true
ProtectHostname=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
ProtectProc=invisible
ProcSubset=pid
InaccessiblePaths=-/run/docker.sock -/run/containerd/containerd.sock -/run/podman/podman.sock
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressAllow=localhost
IPAddressDeny=any
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
MemoryDenyWriteExecute=true
UMask=0077
KeyringMode=private
RemoveIPC=true
MemoryMax=512M
CPUQuota=200%
TasksMax=256
LimitNOFILE=4096
