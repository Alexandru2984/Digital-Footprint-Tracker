[Service]
# Copy only provisioned mappings into a real .conf drop-in. Missing absolute
# credential sources are fatal at service start; do not install placeholders.
LoadCredentialEncrypted=metrics-token:/etc/credstore.encrypted/swift-vapor-metrics-token
Environment=METRICS_TOKEN_FILE=%d/metrics-token

LoadCredentialEncrypted=smtp-password:/etc/credstore.encrypted/swift-vapor-smtp-password
Environment=SMTP_PASS_FILE=%d/smtp-password

LoadCredentialEncrypted=hibp-api-key:/etc/credstore.encrypted/swift-vapor-hibp-api-key
Environment=HIBP_API_KEY_FILE=%d/hibp-api-key
LoadCredentialEncrypted=shodan-api-key:/etc/credstore.encrypted/swift-vapor-shodan-api-key
Environment=SHODAN_API_KEY_FILE=%d/shodan-api-key
LoadCredentialEncrypted=virus-total-api-key:/etc/credstore.encrypted/swift-vapor-virus-total-api-key
Environment=VIRUS_TOTAL_API_KEY_FILE=%d/virus-total-api-key
LoadCredentialEncrypted=abuseipdb-api-key:/etc/credstore.encrypted/swift-vapor-abuseipdb-api-key
Environment=ABUSEIPDB_API_KEY_FILE=%d/abuseipdb-api-key
LoadCredentialEncrypted=abstract-phone-api-key:/etc/credstore.encrypted/swift-vapor-abstract-phone-api-key
Environment=ABSTRACT_PHONE_API_KEY_FILE=%d/abstract-phone-api-key
